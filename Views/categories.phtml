            continue;
        } ?>
        <a class="plain-link" href="/browse/<?= $category['category_id'] ?>">
            <div class="category-box"
                 style="background: linear-gradient( rgb(255 255 255 / 62%), rgb(255 255 255 / 62%) ), url('<?= $category['icon']; ?>')">
                <p><strong><?= $category['name'] ?></strong></p>
                <p><?= $category['package_count'] ?>
                    <?=($category['package_count'] > 4) ? ' veřejných balíčků' : ($category['package_count'] > 1) ? 'veřejné balíčky' : 'veřejný balíček' ?></p>
            </div>
        </a>
    <?php endforeach ?>
</div>
